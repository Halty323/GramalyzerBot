# Copy to .env (git-ignored). Everything is optional for compose.yaml: without a .env both containers start, and the
# server makes its own workspace token (docker compose exec gramalyzer cat /app/keys/api-token).

# The token you sign in to the website with. Leave empty to use the generated one; if set, make it long and random
# (e.g. `openssl rand -hex 32`). Studio picks it up either way.
GRAMALYZER_API_TOKEN=

# Telegram: a token from @BotFather starts the bot and the posting queue (TELEGRAM_BOT_ENABLED=false keeps it off)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_ENABLED=

# Optional bot settings
# Bot admins (can open /admin): your @username and/or numeric user id, comma-separated, e.g. @halty,123456789
BOT_ADMINS=
BOT_PUBLIC_REGISTRATION=true
BOT_DEFAULT_TIMEZONE=Europe/Berlin

# Paid plans (Telegram Stars, renewed every 30 days). Off for local runs, on with compose.vps.yaml; false gives everyone
# unlimited use.
# Free: 1 channel, 3 on the watchlist · Creator: 3 channels, 10 · Pro: 10 channels, 25
# BILLING_ENABLED=true
BILLING_CREATOR_STARS=250
BILLING_PRO_STARS=750

# Where the GramalyzerVibe checkout is, if not next to this one
# GRAMALYZER_VIBE_DIR=../GramalyzerVibe

# Public domain for the VPS setup (compose.vps.yaml); it must already point at the server. See deploy/VPS.md
# DOMAIN=gramalyzer.example.com

# Ports on this machine (both only reachable from it)
# GRAMALYZER_PORT=8080
# STUDIO_PORT=6080
# A password for Studio in the browser, if anything but this machine can reach its port
# STUDIO_VNC_PASSWORD=
# Studio's virtual screen
# STUDIO_SIZE=1440x900

# How long the last channel refresh may take when the server stops (keep below 45 s: stop_grace_period is 60 s)
# REFRESH_STOP_BUDGET=PT25S
# How many daily/shutdown database backups to keep
# BACKUP_KEEP=7

# Database password, only for compose.postgres.yaml
# POSTGRES_PASSWORD=
